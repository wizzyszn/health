{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "cd app && HUSKY=0 corepack pnpm install --frozen-lockfile",
  "buildCommand": "cd app && corepack pnpm build",
  "devCommand": "cd app && corepack pnpm dev",
  "outputDirectory": "app/dist",
  "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }]
}
